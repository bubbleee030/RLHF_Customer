# Copy to .env and fill in. Never commit .env.
#
# The scripts read these from the environment and raise KeyError rather than
# fall back to a baked-in default.

# OpenAI-compatible API (generation + LLM-as-judge)
#   used by: scripts/smoke_test.py, scripts/paraphrase_holdout.py,
#            scripts/llm_annotate_helpfulness.py, scripts/reward/judge_consistency.py,
#            scripts/policy_eval/judge_policy.py, scripts/augment/*, scripts/ppo_lag/judge_cost.py
NCHC_API_KEY=
NCHC_BASE_URL=https://your-openai-compatible-endpoint/v1

# Argilla annotation server
#   used by: argilla/scripts/*.py
ARGILLA_API_KEY=
ARGILLA_API_URL=https://your-argilla-server.hf.space

# HuggingFace, for gated base models such as Ministral-3-3B
HF_TOKEN=
